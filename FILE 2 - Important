import os
import sys

SUPPORTED = {
    "SM-G950F": {
        "name": "Samsung Galaxy S8",
        "regions": ["XEF", "XEO", "INS"],
        "firmware": [
            "G950FXXS8EUB1_HOME.tar.md5",
            "G950FXXS8EUC1_HOME.tar.md5"
        ],
        "tool": "odin"
    },
    "Pixel 3a": {
        "name": "Google Pixel 3a",
        "regions": ["us", "eu", "global"],
        "firmware": [
            "factory-image.zip"
        ],
        "tool": "fastboot"
    }
}

def validate_device(model, region, firmware_file):
    if model not in SUPPORTED:
        raise ValueError("Unsupported device model")
    if region not in SUPPORTED[model]["regions"]:
        raise ValueError("Unsupported region for this model")
    if firmware_file not in SUPPORTED[model]["firmware"]:
        raise ValueError("Firmware package does not match this model")
    return True

def flash_device(model, region, firmware_file):
    validate_device(model, region, firmware_file)
    tool = SUPPORTED[model]["tool"]

    if tool == "odin":
        print(f"[OK] Launching Odin for {model}")
        # call the official Odin workflow only for supported Samsung firmware
    elif tool == "fastboot":
        print(f"[OK] Launching fastboot for {model}")
        # call official fastboot flashing workflow only for supported Pixel firmware
    else:
        raise ValueError("No supported flashing workflow for this device")

if __name__ == "__main__":
    model = "SM-G950F"
    region = "XEF"
    firmware = "G950FXXS8EUB1_HOME.tar.md5"
    flash_device(model, region, firmware)