def validate_pixel(codename: str, region: str) -> Dict[str, object]:
    if codename not in PIXEL_SUPPORT:
        raise ValueError(f"Unsupported Pixel codename: {codename}")

    info = PIXEL_SUPPORT[codename]

    if region not in info["supported_regions"]:
        raise ValueError(
            f"{info['name']} does not support region '{region}'. "
            f"Supported regions: {info['supported_regions']}"
        )

    return info

def flash_pixel(codename: str, region: str, image_zip_path: str) -> None:
    info = validate_pixel(codename, region)

    if not os.path.exists(image_zip_path):
        raise FileNotFoundError(f"Factory image not found: {image_zip_path}")

    print(f"Device: {info['name']}")
    print(f"Flashing tool: {info['tool']}")
    print(f"Bootloader command: {info['bootloader']}")
    print(f"Official firmware source: {info['firmware_source']}")
    print(f"Using image zip: {image_zip_path}")
    print("Next step: follow Google’s official factory-image procedure and use the extracted flash-all.sh / flash-all.bat from the image.")
    print("Do not bypass OEM security or use unsupported firmware.")

if __name__ == "__main__":
