def validate_oneplus(codename: str, region: str) -> dict:
    if codename not in ONEPLUS_SUPPORT:
        raise ValueError(f"Unsupported OnePlus codename: {codename}")

    info = ONEPLUS_SUPPORT[codename]

    if region not in info["supported_regions"]:
        raise ValueError(
            f"{info['name']} does not support region '{region}'. "
            f"Supported regions: {info['supported_regions']}"
        )

    return info

def flash_oneplus(codename: str, region: str, firmware_zip: str) -> None:
    info = validate_oneplus(codename, region)

    if not os.path.exists(firmware_zip):
        raise FileNotFoundError(f"Firmware file not found: {firmware_zip}")

    print(f"Device: {info['name']}")
    print(f"Flashing tool: {info['tool']}")
    print(f"Bootloader requirement: {info['bootloader']}")
    print(f"Official firmware source: {info['official_firmware']}")
    print(f"Using file: {firmware_zip}")
    print("Only proceed with exact model + region + firmware matching.")
    print("Do not bypass OEM security or use unsupported firmware.")

